# Personal data must never be committed.
#
# The skill keeps your config and past drafts in a workspace outside this
# repo (~/journal-writer/ by default). These rules are a second line of
# defense in case anything lands here by accident.

journal-writer/
posts/
config.md
workspace/

# Common accidents — local notes, drafts, transcripts
draft*.md
my-*.md
*.local.md
*-post.md
*-draft.md
*.vtt
*.srt

.DS_Store
__pycache__/
*.pyc
